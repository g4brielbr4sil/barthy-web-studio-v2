# Link direto do WhatsApp Business (formato: https://wa.me/55DDDNUMERO).
# Sem essa env var, o botão de WhatsApp do site fica desabilitado com aviso.
VITE_BARTHY_WHATSAPP_URL=

# Endpoint de intake de leads do Hermes. O payload já é traduzido para o
# schema esperado por ele (name/phone/company/service/message/source/honeypot)
# em src/lib/contact.ts (buildHermesLeadPayload) — não aponte para cá sem
# decisão consciente, pois isso liga o formulário do site à prospecção real.
# Valor de produção conhecido: https://44-199-249-92.sslip.io/api/public/barthy/leads
VITE_BARTHY_CONTACT_ENDPOINT=

VITE_BARTHY_SITE_URL=
VITE_BARTHY_OG_IMAGE=
VITE_BARTHY_ALLOW_INDEXING=false

# Token do Cloudflare Web Analytics (Cloudflare dashboard > Analytics > Web
# Analytics > Add site). Gratuito, sem cookies. Vazio = analytics desativado
# (nenhum script de terceiro é injetado no build).
VITE_BARTHY_CF_ANALYTICS_TOKEN=
