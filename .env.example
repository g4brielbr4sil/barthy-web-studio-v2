# Link oficial do WhatsApp Business. É uma configuração pública e opcional:
# se estiver ausente ou inválida, o site usa este mesmo endereço como fallback.
VITE_BARTHY_WHATSAPP_URL=https://wa.me/5561920002364?text=Ol%C3%A1!%20Conheci%20o%20trabalho%20de%20voc%C3%AAs%20pelo%20site%20da%20*Barthy%20Web%20Studio*%20e%20tenho%20um%20projeto%20em%20mente.%20Poderiam%20me%20orientar%20sobre%20os%20pr%C3%B3ximos%20passos%3F

# Endpoint de intake de leads do Hermes (POST /api/public/barthy/leads). O
# payload já é traduzido para o schema esperado por ele
# (name/phone/email/company/service/message/source/honeypot) em
# src/lib/contact.ts (buildHermesLeadPayload). Só URL absoluta HTTPS é aceita;
# HTTP vale apenas para localhost em desenvolvimento. Vazio = envio online
# desativado, com fallback explícito por e-mail (nunca falso sucesso).
# A URL real de produção fica só na configuração do Cloudflare Pages; ver
# docs/PRODUCTION_CHECKLIST.md.
VITE_BARTHY_CONTACT_ENDPOINT=

# Domínio oficial da Barthy Web Studio. Centraliza canonical, Open Graph e
# sitemap. A origem configurada aqui precisa estar em HERMES_PUBLIC_LEAD_ORIGINS
# no Hermes, senão o POST do formulário volta 403.
VITE_BARTHY_SITE_URL=https://barthywebstudio.tech
VITE_BARTHY_OG_IMAGE=

# Indexação permanece fechada até a liberação explícita.
VITE_BARTHY_ALLOW_INDEXING=false

# Token do Cloudflare Web Analytics (Cloudflare dashboard > Analytics > Web
# Analytics > Add site). Gratuito, sem cookies. Vazio = analytics desativado
# (nenhum script de terceiro é injetado no build).
VITE_BARTHY_CF_ANALYTICS_TOKEN=
